# ── Studio Admin (required) ────────────────────────────────────────
# Password to sign in at /admin. Make this long & unique.
ADMIN_PASSWORD=change-me-please

# ── Data persistence (production) ──────────────────────────────────
# A Postgres connection string — Neon is the recommended serverless host
# (free tier: https://neon.tech → create project → copy "Connection string").
# When set, admin saves live in Postgres; otherwise it falls back to a local
# .data/store.json (development only). Use the "pooled" connection string.
DATABASE_URL=
# Aliases also accepted (pick one, DATABASE_URL wins):
NEON_DATABASE_URL=
POSTGRES_URL=

# ── Image upload target (optional) ────────────────────────────────
# When GITHUB_TOKEN + GITHUB_REPO are set, the admin Image "Upload" button
# commits the image straight into this repo (via the GitHub Contents API).
# Otherwise it writes to local public/images (dev only).
#   * Create a fine-grained PAT with Contents: Read & write for the repo.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo            # e.g. melodytehub-dot/houseofmerola
GITHUB_BRANCH=main                # branch the image is committed to
GITHUB_PATH=public/images         # folder inside the repo
# Optional: API base override (only needed for testing against a mock).
GITHUB_API_BASE=https://api.github.com
# Optional: public base URL to serve images from instead of /images/.
# Set this to bypass a redeploy, e.g. a jsDelivr CDN or raw URL:
#   https://cdn.jsdelivr.net/gh/owner/repo@main/public/images
GITHUB_PUBLIC_BASE=

# ── Free object-store alternative (optional) ───────────────────────
# When the four UPLOAD_* values below are set, image uploads go to any
# S3-compatible store instead of GitHub (GitHub wins if GITHUB_TOKEN+REPO also
# set). Works with Cloudflare R2, Supabase Storage, AWS S3 and MinIO — all free
# at a small/portfolio scale.
#   * Cloudflare R2:    endpoint https://<accountid>.r2.cloudflarestorage.com,
#                       region auto, publicBase https://pub-<hash>.r2.dev/<bucket>
#   * Supabase Storage: endpoint https://<project>.supabase.co/storage/v1/s3,
#                       region auto, publicBase https://<project>.supabase.co/storage/v1/object/public/<bucket>
UPLOAD_ENDPOINT=
UPLOAD_REGION=auto
UPLOAD_BUCKET=
UPLOAD_ACCESS_KEY_ID=
UPLOAD_SECRET_ACCESS_KEY=
# Public URL prefix the admin stores (object key appended). Defaults to /images (dev only).
UPLOAD_PUBLIC_BASE=
# Leave true for MinIO/R2/Supabase (path-style), false for AWS virtual-hosted.
UPLOAD_FORCE_PATH_STYLE=true

# ── Enquiry email forwarding (optional) ────────────────────────────
# Resend is added once the site is live on the real domain.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@houseofmerola.com
ENQUIRY_FROM_EMAIL="House of Merola <onboarding@resend.dev>"
